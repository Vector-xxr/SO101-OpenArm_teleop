<!--
OpenArm v1 single-arm scene for SO101-umi teleop.
Robot model: Enactic OpenArm (Apache-2.0), vendored from
  vr_teleop/openarm_teleop/openarm_mujoco/v1/openarm.xml
Collision STLs are omitted (not present upstream); IK uses kinematics only.
Default arm: single OpenArm (not bimanual). TCP sites:
  ee_native  — vendor link7 axes
  ee_aligned — +X forward, +Y left, +Z up
-->
<mujoco model="openarm_so101_umi">
  <compiler angle="radian" autolimits="true" meshdir="meshes"/>
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>

  <statistic center="0.2 0 0.35" extent="0.9" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <include file="openarm.xml"/>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="ee_target" mocap="true" pos="0.35 0 0.35">
      <site name="ee_target_site" type="sphere" size="0.015" rgba="0.1 0.9 0.2 0.4" group="0"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- nq=9: j1..j7, finger1, finger2. Table-ready: elbow ~80deg. -->
    <key name="home"
      qpos="0 0.35 0 1.40 0 0 0 0.02 0.02"
      ctrl="0 0.35 0 1.40 0 0 0 0.02"/>
  </keyframe>
</mujoco>
